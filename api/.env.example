# Application
APP_NAME=giftlaya-api
APP_ENV=development
APP_PORT=8080

# CORS (comma-separated admin + storefront origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://giftlaya:giftlaya_dev_pass@localhost:5432/giftlaya?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & Security (CHANGE ALL SECRETS IN PRODUCTION)
JWT_ACCESS_SECRET=replace-with-32-byte-min-random-access-secret
JWT_REFRESH_SECRET=replace-with-32-byte-min-random-refresh-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=168
TOTP_ENC_KEY=replace-with-exactly-32-char-aes-key
TOTP_ISSUER=Giftlaya CMS

# S3 / MinIO Media Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=giftlaya-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
CDN_BASE_URL=http://localhost:9000/giftlaya-media

# Seed Super Admin (used only by cmd/seed)
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_EMAIL=admin@giftlaya.com
SEED_ADMIN_PASSWORD=ChangeMe@2026!
SEED_ADMIN_ACCESS_CODE=918100

