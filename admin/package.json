{
  "name": "giftlaya-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "gen:api": "npx swagger2openapi ../giftlaya-api/docs/swagger.json -o ./openapi.json && npx openapi-typescript ./openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.74.3",
    "lucide-react": "^0.503.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "openapi-typescript": "^7.6.1",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}

