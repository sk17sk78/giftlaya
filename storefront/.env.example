# Backend API Base URL
# If empty or unreachable, the application falls back to realistic mock data extracted from Giftlaya
NEXT_PUBLIC_API_BASE_URL=https://api.giftlaya.example.com/api

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp & Support Phone
NEXT_PUBLIC_SUPPORT_PHONE=+918100248353
NEXT_PUBLIC_SUPPORT_EMAIL=support@giftlaya.com
NEXT_PUBLIC_WHATSAPP_NUMBER=918100248353

# Slider Config Override (true/false when backend /config/homepage isn't connected)
NEXT_PUBLIC_ENABLE_SLIDER=true
